*.py[cod]
.pytest_cache/
/.venv/
/.vscode/
/.idea/
/.codex/
/.agents/
/.codex_ssh_askpass.cmd
/*_known_hosts
/.env
/.env.*
!/.env.example
/*.pem
/*.key
/*.ppk
*.bak
*.swp
*~
.DS_Store
Thumbs.db
