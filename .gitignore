# Public source package: Quartus sources, runtime MRAs, README, and upstream
# notices, matching the lean Toaplan repositories. Engineering and verification
# material stays local. Keep .hex/.mem/.mif FPGA initialization tables.

# Quartus generated databases, reports, GUI state, and programming files
/db/
/incremental_db/
/output_files/
/work/
/work_*/
/modelsim.ini
*.qdb
*.qtl
*.qpg
*.rpt
*.summary
*.smsg
*.qws
*.done
*.pin
*.jdi
*.sld
*.sof
*.rbf
/c5_pin_model_dump.txt
/cr_ie_info.json

# Both files are regenerated by the required sys/build_id.tcl pre-flow script.
/build_id.v
/jtag.cdf

# Unused PLL simulation/GUI sidecars; retain synthesis .v/.qip/IP sources.
/raizingpll.xml
/rtl/raizingpll_sim.f
/rtl/raizingpll_sim/
/rtl/raizingpll.bsf
/rtl/raizingpll.ppf
/rtl/raizingpll.sip
/rtl/raizingpll.spd

# Local engineering material (not needed to build or run the public core)
/AGENTS.md
/docs/
/tools/
/sim/
/cfg/
/nvram/
/snap/
/build/
/captures/
/tmp/
/.codex-backups/
/evidence/private/
/releases/private/

# Unused upstream development tools, documentation, tests, and other targets.
# Retain upstream HDL, initialization data, licenses, README, and provenance.
/rtl/modules/jtframe/asm/
/rtl/modules/jtframe/bin/*
!/rtl/modules/jtframe/bin/font0.pf
/rtl/modules/jtframe/cc/
/rtl/modules/jtframe/cfg/
/rtl/modules/jtframe/devops/
/rtl/modules/jtframe/doc/
/rtl/modules/jtframe/mame/
/rtl/modules/jtframe/src/
/rtl/modules/jtframe/syn/
/rtl/modules/jtframe/target/*
!/rtl/modules/jtframe/target/mister/
/rtl/modules/jtframe/target/mister/*
!/rtl/modules/jtframe/target/mister/hdl/
/rtl/modules/jtframe/target/mister/hdl/*
# Unlike Knuckle Bash, FixEight's rtl/jtframe.qip uses these target modules.
!/rtl/modules/jtframe/target/mister/hdl/jtframe_mister_dwnld.v
!/rtl/modules/jtframe/target/mister/hdl/jtframe_mister_status.v
!/rtl/modules/jtframe/target/mister/hdl/jtframe_mister_cartsave.v
!/rtl/modules/jtframe/target/mister/hdl/jtframe_target_info.sv
!/rtl/modules/jtframe/target/mister/hdl/jtframe_mr_ddrmux.v
!/rtl/modules/jtframe/target/mister/hdl/jtframe_joymux.v
!/rtl/modules/jtframe/target/mister/hdl/joydb15.v
# Keep the upstream font source above and its configured bin search directory.
/rtl/modules/jtframe/ver/
/rtl/modules/jtframe/verilator/
/rtl/modules/jtframe/hdl/ver/
/rtl/modules/jt6295/cc/
/rtl/modules/jt6295/cfg/
/rtl/modules/jt6295/doc/
/rtl/modules/jt6295/src/
/rtl/modules/jt6295/ver/
/rtl/modules/fx68k/cfg/
/rtl/modules/fx68k/hdl/verilator/

# ModelSim, Verilator, MAME, and analysis products
transcript
work/
work_*/
obj_dir/
*.wlf
*.vcd
*.fst
*.vstf
*.log
*.err.log

# Game ROMs, EEPROM/NVRAM data, aggregates, and A/V captures are never source
# assets. Users must supply their own compatible ROM sets.
*.zip
*.7z
*.rom
*.bin
*.nv
*.nvm
*.aggregate
*.raw
*.wav
*.avi
*.mkv
*.mp4

